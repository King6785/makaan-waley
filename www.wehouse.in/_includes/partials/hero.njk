<div class="wh-home bg-gray-50 overflow-x-hidden">
  <!-- Scroll progress bar (fixed top) -->
  <div id="scroll-progress" class="fixed top-0 left-0 right-0 h-0.5 bg-primary-500/30 z-[100] origin-left scale-x-0" aria-hidden="true"></div>

  <!-- Section 1: HERO -->
  <section class="relative flex min-h-0 flex-col overflow-hidden bg-white pt-24 pb-12 md:pt-28 md:pb-20 lg:min-h-svh" id="hero">
    <div class="absolute inset-0 pointer-events-none z-[2]" aria-hidden="true">
      <div class="absolute -top-24 -left-24 h-72 w-72 rounded-full bg-primary-200/40 blur-3xl"></div>
      <div class="absolute -bottom-20 -right-20 h-80 w-80 rounded-full bg-primary-100/50 blur-3xl"></div>
    </div>
    <div class="absolute inset-0 pointer-events-none bg-[url('{{ site.hero.images.hero_bg }}')] bg-no-repeat bg-bottom bg-[length:100%_auto]" aria-hidden="true"></div>
    <div class="hero-family-fades pointer-events-none absolute inset-x-0 bottom-0 z-[1] h-[28%] sm:h-[40%] md:h-[58%]" aria-hidden="true">
      <picture>
        <source media="(min-width: 768px)" type="image/webp" srcset="{{ site.hero.images.family_1 }}" />
        <img src="{{ site.hero.images.family_1 }}" alt="" class="hero-family-fade is-active" width="1536" height="1024" loading="eager" decoding="async" fetchpriority="low" />
      </picture>
      <picture>
        <source media="(min-width: 768px)" type="image/webp" srcset="{{ site.hero.images.family_2 }}" />
        <img src="{{ site.hero.images.family_2 }}" alt="" class="hero-family-fade" width="1536" height="1024" loading="lazy" decoding="async" />
      </picture>
      <picture>
        <source media="(min-width: 768px)" type="image/webp" srcset="{{ site.hero.images.family_3 }}" />
        <img src="{{ site.hero.images.family_3 }}" alt="" class="hero-family-fade" width="1536" height="1024" loading="lazy" decoding="async" />
      </picture>
    </div>
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute w-[420px] h-[420px] -right-[7.5rem] -top-20 rounded-full blur-[40px] opacity-90 bg-[radial-gradient(circle_at_center,rgba(249,115,22,0.32),transparent_65%)]"></div>
      <div class="absolute w-[360px] h-[360px] -left-[6.25rem] -bottom-20 rounded-full blur-[40px] opacity-90 bg-[radial-gradient(circle_at_center,rgba(253,186,116,0.28),transparent_65%)]"></div>
    </div>
    <div class="absolute inset-0 opacity-[0.16] pointer-events-none bg-[linear-gradient(rgba(15,23,42,0.24)_1px,transparent_1px),linear-gradient(90deg,rgba(15,23,42,0.16)_1px,transparent_1px)] bg-[length:64px_64px] [mask-image:radial-gradient(circle_at_center,black_0%,transparent_70%)]" aria-hidden="true"></div>
    <div class="absolute -right-24 -bottom-12 md:-right-20 md:-bottom-12 w-[360px] md:w-[520px] h-[220px] md:h-80 opacity-[0.16] md:opacity-[0.24] mix-blend-soft-light pointer-events-none bg-[url('{{ site.hero.images.w_shape }}')] bg-no-repeat bg-contain bg-center" aria-hidden="true"></div>

    <!-- Cursor Following Blob -->
    <div id="cursor-blob" class="pointer-events-none fixed w-[300px] h-[300px] rounded-full bg-primary-200/20 blur-3xl z-[5] opacity-0 transition-opacity duration-500"></div>

    <!-- Main Content -->
    <div class="relative z-10 max-w-6xl xl:max-w-6xl 2xl:max-w-[90rem] mx-auto px-4 flex-1 flex flex-col justify-center w-full">
      <div class="flex flex-col justify-start gap-8 py-4 lg:flex-row lg:items-center lg:justify-between lg:gap-12 xl:gap-16 lg:py-6">
        <!-- Left: Messaging -->
        <div class="flex-1 min-w-0 max-w-[46rem] lg:max-w-none">
          <div class="relative flex flex-col items-center text-center md:items-start md:text-left [&>*]:relative [&>*]:z-[1]">
            <div class="hero-kicker hero-tagline opacity-0 translate-y-6 mb-5 sm:mb-6 inline-flex w-fit max-w-full items-center gap-2 self-center rounded-full border border-primary-400 bg-gradient-to-r from-primary-50 to-primary-100 px-3 py-1.5 sm:gap-2.5 sm:px-4 sm:py-2 md:self-start wh-meta font-bold text-primary-800 shadow-lg shadow-primary-200/60 ring-1 ring-primary-300/60">
              <!-- Pulse live dot -->
              <span class="relative flex h-2 w-2 shrink-0">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
              </span>
              <span class="text-left leading-tight tracking-wider uppercase sm:tracking-widest">{{ site.hero.kicker | safe }}</span>
            </div>

            <h1 class="hero-headline wh-heading-hero opacity-0 translate-y-6 mb-4 md:mb-5 text-dark">
              {{ site.hero.headline | safe }}
            </h1>

            <p class="hero-subheadline wh-body-lg opacity-0 translate-y-6 mb-6 max-w-md text-gray-600 md:mb-8">
              {{ site.hero.subheadline }}
            </p>

            <div class="hero-cta opacity-0 translate-y-6 flex w-full max-w-sm flex-col items-stretch gap-3 sm:max-w-none sm:flex-row sm:items-center md:items-start">
              <a href="#" id="hero-cta-primary" data-lead-popup-trigger class="wh-btn-primary wh-btn--lg hero-cta-magnetic group w-full sm:w-auto">
                <span>{{ site.hero.cta_primary }}</span>
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </a>
              <a href="{{ site.hero.cta_secondary_href }}" class="wh-btn-secondary wh-btn--lg group w-full sm:w-auto">
                <svg class="w-4 h-4 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                {{ site.hero.cta_secondary }}
              </a>
            </div>

            <!-- Hero Stats -->
            <div class="hero-stats opacity-0 translate-y-6 mt-7 w-full md:w-auto">
              <div class="hero-stats-bar grid grid-cols-2 overflow-hidden rounded-2xl border border-gray-100 bg-white/80 shadow-md shadow-gray-100/80 backdrop-blur-sm md:flex md:items-center">
                {% for stat in site.hero.stats %}
                <div class="flex items-center gap-2 {% if not loop.first %}border-l{% endif %} {% if not loop.last %}border-b md:border-b-0{% else %}border-r-0{% endif %} border-gray-100 px-3 py-2.5 md:border-b-0">
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-primary-50 text-primary-600">
                    {% icon stat.icon %}
                  </span>
                  <div class="flex min-w-0 flex-col">
                    <span class="wh-stat-sm text-dark">{{ stat.value }}</span>
                    <span class="wh-meta mt-0.5 font-medium text-gray-400">{{ stat.label }}</span>
                  </div>
                </div>
                {% endfor %}
              </div>
            </div>

          </div>
        </div>

        <!-- Right: Dynamic quick enquiry form -->
        <div class="relative w-full max-w-md mx-auto shrink-0 pt-10 md:pt-6 lg:max-w-none lg:w-[320px] xl:w-[340px] lg:self-start">
          <img src="{{ site.hero.images.stamp }}" alt="500+ projects" width="104" height="104" class="hero-stamp pointer-events-none absolute z-20 left-0 right-0 mx-auto top-0 w-16 md:left-auto md:right-auto md:mx-0 md:-left-[3.25rem] md:w-[6rem] lg:-left-[3.5rem] lg:w-[6.5rem] opacity-0 select-none drop-shadow-[0_8px_14px_rgba(15,23,42,0.16)]" loading="eager" decoding="async" />
          <div class="wh-form-card relative hero-form reveal-right p-5 pt-12 md:p-6">
            <div class="mb-3">
              <h3 class="wh-heading-md text-dark text-center md:text-right">{{ site.hero.form.step1.title }}</h3>
            </div>

            <div id="hero-form-steps-wrap">
            <!-- Step indicator -->
            <span id="hero-step-label" class="sr-only">Step 1 of 3</span>

            <form id="hero-enquiry-form" class="space-y-3" novalidate data-privyr-api="/api/privyr-lead" data-thank-you-url="/thank-you" data-lead-source="Homepage hero">
              <!-- Step 1: Name, Email, Timeframe -->
              <div class="hero-step min-h-[200px]" data-hero-step="1">
                <div class="space-y-3">
                  {% for field in site.hero.form.step1.fields %}
                  <div>
                    <label for="hero-{{ field.id }}" class="wh-field-label">{{ field.label }}</label>
                    {% if field.type == "select" %}
                    <select id="hero-{{ field.id }}" name="{{ field.id }}" {% if field.required %}data-hero-required{% endif %} data-hero-step="1" class="wh-field-input">
                      {% for opt in field.options %}
                      <option value="{{ opt.value }}">{{ opt.label }}</option>
                      {% endfor %}
                    </select>
                    {% else %}
                    <input id="hero-{{ field.id }}" name="{{ field.id }}" type="{{ field.type }}" autocomplete="{{ field.type }}" {% if field.required %}data-hero-required{% endif %} data-hero-step="1" class="wh-field-input" placeholder="{{ field.placeholder }}" />
                    {% endif %}
                  </div>
                  {% endfor %}
                </div>
              </div>

              <!-- Step 2: City + Phone -->
              <div class="hero-step hidden min-h-[200px]" data-hero-step="2">
                <div class="space-y-3">
                  {% for field in site.hero.form.step2.fields %}
                  <div>
                    <label for="hero-{{ field.id }}" class="wh-field-label">{{ field.label }}</label>
                    {% if field.type == "select" %}
                    <select id="hero-{{ field.id }}" name="{{ field.id }}" {% if field.required %}data-hero-required{% endif %} data-hero-step="2" class="wh-field-input">
                      {% for opt in field.options %}
                      <option value="{{ opt.value }}">{{ opt.label }}</option>
                      {% endfor %}
                    </select>
                    {% else %}
                    <input id="hero-{{ field.id }}" name="{{ field.id }}" type="{{ field.type }}" inputmode="{{ field.type }}" autocomplete="{{ field.type }}" {% if field.required %}data-hero-required{% endif %} data-hero-step="2" class="wh-field-input" placeholder="{{ field.placeholder }}" />
                    {% endif %}
                  </div>
                  {% endfor %}
                </div>
              </div>

              <!-- Step 3: Plot Size + Submit -->
              <div class="hero-step hidden min-h-[140px] space-y-4" data-hero-step="3">
                <div id="hero-plot-size-group">
                  {% for field in site.hero.form.step3.fields %}
                  <label for="hero-{{ field.id }}" class="wh-field-label">{{ field.label }}</label>
                  <div class="flex items-center gap-2">
                    <input id="hero-{{ field.id }}" name="{{ field.id }}" type="{{ field.type }}" min="{{ field.min }}" max="{{ field.max }}" step="{{ field.step }}" {% if field.required %}data-hero-required{% endif %} data-hero-step="3" class="wh-field-input [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none" placeholder="{{ field.placeholder }}" />
                    <span class="wh-meta font-semibold text-gray-500 px-2 py-1 rounded-lg bg-gray-50 border border-gray-200">{{ field.unit }}</span>
                  </div>
                  {% endfor %}
                </div>
                <div id="hero-otp-wrap" class="space-y-2">
                  <p class="wh-label-sm text-gray-800">{{ site.hero.form.step3.otp_text }}</p>
                  <div id="hero-otp-card" class="rounded-xl border border-primary-200/80 bg-gradient-to-b from-primary-50/70 to-white p-3 space-y-2" data-lead-otp-block>
    <p id="hero-otp-phone-hint" class="wh-meta text-gray-600" data-otp-phone-hint></p>
    <div class="flex flex-wrap items-center gap-2">
        <button type="button" id="hero-send-otp" data-label="Send OTP" data-otp-send class="inline-flex items-center justify-center rounded-md border border-primary-500 bg-white px-3 py-1.5 wh-label-sm text-primary-800 hover:bg-primary-50">Send OTP</button>
        <span id="hero-otp-status" class="hidden" aria-live="polite" data-otp-status><span class="inline-flex items-center gap-1 wh-label-sm text-green-700"><span class="text-green-600" aria-hidden="true">✓</span> Mobile verified</span></span>
    </div>
    <div id="hero-otp-fields" class="space-y-1.5" data-otp-fields>
        <label for="hero-otp" class="wh-label-sm text-gray-700">Enter OTP from SMS</label>
        <div class="flex gap-2">
            <input id="hero-otp" name="otp" type="text" inputmode="numeric" maxlength="8" autocomplete="one-time-code" class="flex-1 rounded-lg border border-gray-200 px-3 py-2 text-sm" placeholder="6-digit OTP" data-otp-input />
            <button type="button" id="hero-verify-otp" data-otp-verify class="shrink-0 rounded-lg bg-primary-600 px-3 py-2 wh-label-sm text-white hover:bg-primary-700">Verify</button>
        </div>
    </div>
</div>
<input type="text" name="hp_website" value="" tabindex="-1" autocomplete="off" class="sr-only absolute -left-[9999px] w-0 h-0 opacity-0" aria-hidden="true" />

                </div>
                <p id="hero-submit-hint" class="wh-label-sm text-center text-primary-900/80 font-medium leading-snug hidden">
                  Verify your mobile with OTP above — then you can get your smart plan.
                </p>
                <button type="submit" id="hero-submit-btn" class="wh-btn-primary wh-btn--block wh-btn--sm">
                  <span>{{ site.hero.form.step3.submit_text }}</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </button>
              </div>

              <!-- Navigation: Back + Next (Submit lives inside Step 3) -->
              <div class="flex items-center gap-2 pt-1">
                <button type="button" id="hero-back-btn" class="wh-btn-secondary wh-btn--sm hidden" aria-label="Previous step">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                  Back
                </button>
                <button type="button" id="hero-next-btn" class="wh-btn-primary wh-btn--sm flex-1">
                  Next Step
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </button>
              </div>

              <p id="hero-form-error" class="hidden text-sm text-red-600 text-center"></p>
              <p class="flex items-center justify-center gap-2 mt-1 px-3 py-2 rounded-xl bg-primary-500/6 border border-primary-500/14 wh-meta italic text-center text-stone-600">
                <svg class="shrink-0 w-4 h-4 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                <span>{{ site.hero.form.step3.privacy_text }}</span>
              </p>
            </form>
            </div>

            <!-- Success step (shown after submit) -->
            <div id="hero-form-success-step" class="hidden min-h-[200px] flex flex-col items-center justify-center text-center py-6">
              <div class="w-20 h-20 flex items-center justify-center mb-4 rounded-full bg-green-100">
                <svg class="w-10 h-10 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <h3 class="wh-heading-md text-dark mb-2">{{ site.hero.form.success.title }}</h3>
              <p class="text-gray-600 max-w-sm">{{ site.hero.form.success.message }}</p>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>