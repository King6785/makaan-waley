<region aria-labelledby="testimonials-title" class="py-16 md:py-24 lg:py-32 bg-gray-50">
  <div class="mx-auto max-w-[90rem] px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
      <p class="wh-label-sm font-semibold text-primary-500 tracking-wider uppercase mb-3">{{ site.testimonials.section_label }}</p>
      <h2 id="testimonials-title" class="wh-heading-xl text-dark">{{ site.testimonials.title }}</h2>
      <p class="mt-4 wh-body-lg text-gray-600">{{ site.testimonials.subtitle }}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {% for client in site.testimonials.clients %}
      <article class="group relative rounded-2xl border border-gray-100 bg-white p-6 md:p-8 transition-all duration-300 hover:border-primary-200 hover:shadow-xl hover:shadow-primary-100/50">
        <div class="flex items-center gap-4 mb-4">
          <img src="{{ client.image }}" alt="{{ client.name }}" class="h-14 w-14 rounded-full object-cover ring-2 ring-primary-100" loading="lazy" decoding="async" />
          <div>
            <h3 class="wh-heading-sm text-dark">{{ client.name }}</h3>
            <p class="wh-meta text-gray-500">Homeowner</p>
          </div>
        </div>
        <blockquote class="wh-body text-gray-600 italic">"WeHouse made our dream home a reality. The transparency and quality were unmatched."</blockquote>
      </article>
      {% endfor %}
    </div>
    <div class="text-center">
      <a href="#" class="wh-btn-primary wh-btn--lg" data-lead-popup-trigger>
        {{ site.testimonials.cta_text }}
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </div>
</region>