<region aria-labelledby="services-title" class="py-16 md:py-24 lg:py-32 bg-white">
  <div class="mx-auto max-w-[90rem] px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
      <p class="wh-label-sm font-semibold text-primary-500 tracking-wider uppercase mb-3">{{ site.services.section_label }}</p>
      <h2 id="services-title" class="wh-heading-xl text-dark">{{ site.services.title }}</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {% for item in site.services.items %}
      <a href="{{ item.href }}" class="group relative block rounded-2xl border border-gray-100 bg-white p-6 md:p-8 transition-all duration-300 hover:border-primary-200 hover:shadow-xl hover:shadow-primary-100/50">
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-primary-50 text-primary-500 group-hover:bg-primary-100 group-hover:text-primary-600 transition-colors">
          {% icon item.icon %}
        </div>
        <h3 class="mt-5 wh-heading-md text-dark group-hover:text-primary-500 transition-colors">{{ item.title }}</h3>
        <p class="mt-3 wh-btn-secondary wh-btn--sm inline-flex items-center gap-2 text-sm font-semibold text-primary-500 hover:text-white hover:bg-primary-500">
          {{ item.cta }}
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </p>
      </a>
      {% endfor %}
    </div>
  </div>
</region>