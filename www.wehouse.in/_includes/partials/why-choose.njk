<region aria-labelledby="why-choose-title" class="py-16 md:py-24 lg:py-32 bg-gray-50">
  <div class="mx-auto max-w-[90rem] px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
      <p class="wh-label-sm font-semibold text-primary-500 tracking-wider uppercase mb-3">{{ site.whyChoose.section_label }}</p>
      <h2 id="why-choose-title" class="wh-heading-xl text-dark">{{ site.whyChoose.title }}</h2>
      <p class="mt-4 wh-body-lg text-gray-600">{{ site.whyChoose.subtitle }}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {% for feature in site.whyChoose.features %}
      <div class="group relative rounded-2xl border border-gray-100 bg-white p-6 md:p-8 transition-all duration-300 hover:border-primary-200 hover:shadow-xl hover:shadow-primary-100/50">
        <h3 class="wh-heading-md text-dark">{{ feature.title }}</h3>
        {% if feature.description %}
        <p class="mt-3 wh-body text-gray-600">{{ feature.description }}</p>
        {% endif %}
        {% if feature.link %}
        <a href="{{ feature.link_href }}" class="mt-4 wh-btn-secondary wh-btn--sm inline-flex items-center gap-2 text-sm font-semibold text-primary-500 hover:text-white hover:bg-primary-500">
          {{ feature.link }}
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</region>