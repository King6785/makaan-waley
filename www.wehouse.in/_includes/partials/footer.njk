<footer class="bg-dark text-white relative overflow-hidden">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute -top-40 -right-40 w-[600px] h-[600px] bg-primary-500/5 rounded-full blur-[120px]"></div>
  </div>
  <div class="relative mx-auto max-w-[90rem] px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 md:gap-12 mb-12 md:mb-16">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <a href="index.html" class="flex items-center gap-2 mb-6">
          <img src="{{ site.brand.logo_white }}" alt="{{ site.brand.name }}" class="h-10 w-auto" />
        </a>
        <p class="wh-body text-white/60 max-w-xs">{{ site.footer.description }}</p>
        <div class="mt-8 flex gap-4">
          <a href="{{ site.footer.social.facebook }}" class="text-white/50 hover:text-primary-400 transition-colors" aria-label="Facebook"><svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></a>
          <a href="{{ site.footer.social.instagram }}" class="text-white/50 hover:text-primary-400 transition-colors" aria-label="Instagram"><svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg></a>
          <a href="{{ site.footer.social.linkedin }}" class="text-white/50 hover:text-primary-400 transition-colors" aria-label="LinkedIn"><svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>
          <a href="{{ site.footer.social.youtube }}" class="text-white/50 hover:text-primary-400 transition-colors" aria-label="YouTube"><svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505a3.017 3.017 0 00-2.122 2.136C1.564 7.514 1.564 12 1.564 12s0 4.486.505 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 16.486 24 12 24 12s0-4.486-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg></a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="wh-heading-sm font-semibold mb-4">QUICK LINKS</h3>
        <ul class="space-y-3">
          {% for link in site.footer.quick_links %}
          <li><a href="{{ link.href }}" class="wh-body text-white/70 hover:text-primary-400 transition-colors">{{ link.label }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3 class="wh-heading-sm font-semibold mb-4">SERVICES</h3>
        <ul class="space-y-3">
          {% for link in site.footer.services_links %}
          <li><a href="{{ link.href }}" class="wh-body text-white/70 hover:text-primary-400 transition-colors">{{ link.label }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <!-- Cities -->
      <div>
        <h3 class="wh-heading-sm font-semibold mb-4">CITIES</h3>
        <ul class="space-y-3">
          {% for city in site.footer.cities %}
          <li>
            <p class="wh-heading-sm font-medium">{{ city.name }}</p>
            <p class="wh-meta text-white/50 mt-1">{{ city.address }}</p>
          </li>
          {% endfor %}
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 pt-8">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <p class="wh-body text-white/50">{{ site.footer.copyright }}</p>
        <div class="flex flex-wrap items-center justify-center md:justify-end gap-6 text-white/50">
          <a href="#" class="wh-meta hover:text-primary-400 transition-colors">Privacy Policy</a>
          <a href="#" class="wh-meta hover:text-primary-400 transition-colors">Terms of Service</a>
          <a href="#" class="wh-meta hover:text-primary-400 transition-colors">Cookie Policy</a>
        </div>
      </div>
    </div>
  </div>
</footer>