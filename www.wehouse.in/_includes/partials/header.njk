<header id="site-header" class="fixed top-0 left-0 right-0 z-50 bg-transparent transition-all duration-300 ease-out">
  <nav class="mx-auto flex max-w-[90rem] items-center justify-between gap-3 px-4 py-4 sm:gap-4 sm:px-6 lg:px-8">
    <div class="flex min-w-0 items-center">
      <a href="index.html" class="relative flex h-10 shrink-0 items-center gap-2">
        <img id="header-logo" src="{{ site.brand.logo }}" alt="{{ site.brand.name }}" class="block h-10 w-auto transition-opacity duration-300" fetchpriority="high" />
        <img id="header-logo-white" src="{{ site.brand.logo_white }}" alt="{{ site.brand.name }}" class="absolute left-0 top-1/2 h-10 w-auto -translate-y-1/2 opacity-0 transition-opacity duration-300" />
      </a>
    </div>
    <div id="nav-desktop" class="hidden items-center gap-5 lg:flex lg:gap-6 xl:gap-7">
      <div id="nav-city-wrap" class="relative flex h-10 shrink-0 items-center">
        <select id="nav-city" name="city" class="sr-only" tabindex="-1" aria-hidden="true">
          <option value="">City</option>
          {% for city in site.navigation.cities %}
          <option value="{{ city }}">{{ city }}</option>
          {% endfor %}
        </select>
        <button type="button" id="nav-city-trigger" class="inline-flex h-full max-w-[7.25rem] items-center gap-1 wh-label-sm leading-none text-dark transition-colors hover:text-primary-500 sm:max-w-[9rem]" aria-haspopup="listbox" aria-expanded="false" aria-controls="nav-city-menu">
          <svg class="h-3.5 w-3.5 shrink-0 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span id="nav-city-label" class="truncate">City</span>
          <svg class="h-3.5 w-3.5 shrink-0 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>
        <div id="nav-city-menu" class="nav-city-menu hidden absolute left-0 top-full z-[60] mt-2 w-44 max-h-64 overflow-y-auto rounded-xl border border-gray-200 bg-white p-1.5 shadow-xl" role="listbox" aria-label="Select your city">
          <button type="button" role="option" data-nav-city-value="" class="nav-city-option block w-full rounded-lg px-3 py-2 text-left text-sm text-gray-700 hover:bg-primary-50 hover:text-primary-600">Select city</button>
          {% for city in site.navigation.cities %}
          <button type="button" role="option" data-nav-city-value="{{ city }}" class="nav-city-option block w-full rounded-lg px-3 py-2 text-left text-sm text-gray-700 hover:bg-primary-50 hover:text-primary-600">{{ city }}</button>
          {% endfor %}
        </div>
      </div>
      <a href="index.html" id="nav-desktop-home" class="wh-label-sm text-dark hover:text-primary-500 transition-colors">Home</a>
      {% for item in site.navigation.nav_items %}
      {% if item.dropdown %}
      <div class="relative group" data-nav-dropdown>
        <button type="button" class="inline-flex items-center gap-1 wh-label-sm text-dark hover:text-primary-500 transition-colors cursor-pointer" aria-haspopup="true" aria-expanded="false" aria-controls="nav-{{ item.label | lower | replace(' ', '-') }}-menu">
          {{ item.label }}
          <svg class="h-4 w-4 transition-transform group-data-[open]:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div id="nav-{{ item.label | lower | replace(' ', '-') }}-menu" class="invisible absolute left-0 top-full z-50 w-72 rounded-xl border border-gray-200 bg-white p-2 opacity-0 shadow-xl transition-all duration-150 pointer-events-none group-hover:visible group-hover:opacity-100 group-hover:pointer-events-auto group-focus-within:visible group-focus-within:opacity-100 group-focus-within:pointer-events-auto group-data-[open]:visible group-data-[open]:opacity-100 group-data-[open]:pointer-events-auto">
          {% for sub in item.dropdown %}
          <a href="{{ sub.href }}" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-gray-700 hover:bg-primary-50 hover:text-primary-600">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-primary-50 text-primary-500">
              {% icon sub.icon %}
            </span>
            {{ sub.label }}
          </a>
          {% endfor %}
        </div>
      </div>
      {% else %}
      <a href="{{ item.href }}" class="wh-label-sm text-dark hover:text-primary-500 transition-colors">{{ item.label }}</a>
      {% endif %}
      {% endfor %}
      <button type="button" data-lead-popup-trigger data-lead-popup-title="{{ site.navigation.cta_popup_title }}" data-lead-popup-lede="{{ site.navigation.cta_popup_lede }}" class="rounded-xl bg-primary-500 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary-600 transition-all duration-300 hover:shadow-lg hover:shadow-primary-500/25">{{ site.navigation.cta_text }}</button>
    </div>
    <button id="nav-toggle" type="button" class="inline-flex shrink-0 touch-manipulation items-center justify-center rounded-md p-2 text-dark hover:bg-gray-100 lg:hidden" aria-label="Toggle menu" aria-controls="nav-mobile" aria-expanded="false">
      <svg id="nav-icon-open" class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="nav-icon-close" class="hidden h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>
  <div id="nav-mobile" class="hidden border-t border-white/10 bg-dark lg:hidden max-h-[calc(100dvh-4.5rem)] overflow-y-auto">
    <div class="flex flex-col gap-1 px-4 py-4">
      <div id="nav-city-mobile-slot" class="px-1 py-1"></div>
      <a href="index.html" id="nav-mobile-home" class="rounded-lg px-3 py-2 wh-label-sm text-white/80 hover:text-primary-500 hover:bg-white/5 transition-colors">Home</a>
      <details name="mobile-nav" class="open:[&_summary_svg]:rotate-180">
        <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2 wh-label-sm text-white/80 transition-colors hover:bg-white/5 hover:text-primary-500 [&::-webkit-details-marker]:hidden">
          Services
          <svg class="h-4 w-4 shrink-0 transition-transform duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </summary>
        <div class="mb-1 ml-2 flex flex-col gap-0.5 border-l border-white/10 pl-2">
          {% for item in site.navigation.nav_items %}
          {% if item.dropdown %}
          {% for sub in item.dropdown %}
          <a href="{{ sub.href }}" class="rounded-lg px-3 py-2 text-sm text-white/70 hover:bg-white/5 hover:text-primary-500 transition-colors">{{ sub.label }}</a>
          {% endfor %}
          {% endif %}
          {% endfor %}
        </div>
      </details>
      {% for item in site.navigation.nav_items %}
      {% if not item.dropdown %}
      <a href="{{ item.href }}" class="rounded-lg px-3 py-2 wh-label-sm text-white/80 hover:text-primary-500 hover:bg-white/5 transition-colors">{{ item.label }}</a>
      {% endif %}
      {% endfor %}
      <details name="mobile-nav" class="open:[&_summary_svg]:rotate-180">
        <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2 wh-label-sm text-white/80 transition-colors hover:bg-white/5 hover:text-primary-500 [&::-webkit-details-marker]:hidden">
          More
          <svg class="h-4 w-4 shrink-0 transition-transform duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </summary>
        <div class="mb-1 ml-2 flex flex-col gap-0.5 border-l border-white/10 pl-2">
          {% for item in site.navigation.nav_items %}
          {% if item.dropdown and item.label == "More" %}
          {% for sub in item.dropdown %}
          <a href="{{ sub.href }}" class="rounded-lg px-3 py-2 text-sm text-white/70 hover:bg-white/5 hover:text-primary-500 transition-colors">{{ sub.label }}</a>
          {% endfor %}
          {% endif %}
          {% endfor %}
        </div>
      </details>
      <button type="button" data-lead-popup-trigger data-lead-popup-title="{{ site.navigation.cta_popup_title }}" data-lead-popup-lede="{{ site.navigation.cta_popup_lede }}" class="mt-2 rounded-xl bg-primary-500 px-3 py-2 text-center text-sm font-semibold text-white hover:bg-primary-600">{{ site.navigation.cta_text }}</button>
    </div>
  </div>
</header>