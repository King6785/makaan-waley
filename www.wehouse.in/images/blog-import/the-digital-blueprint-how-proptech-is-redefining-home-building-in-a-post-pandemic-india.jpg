 <script>
    function DropDown(el) {
        this.dd = el;
        this.placeholder = this.dd.children('span');
        this.opts = this.dd.find('ul.drop li');
        this.val = '';
        this.index = -1;
        this.initEvents();
    }

    // function jquery(data){
    //     $.ajax({
    //         url: '/get_price',
    //         type: 'post',
    //         data: data,
    //         success: function(array){
    //         let jso = JSON.parse(array);
    //         message = ''
    //         }
    //     });
    // }

    function jquery(thi) {
        var city = thi.getAttribute('value');
         var baseurl = "http://www.wehouse.in/";
        //  alert(baseurl);
        var dat = 'city='+city;
        var xmlhttp = new XMLHttpRequest();
            xmlhttp.onreadystatechange = function() {
            if (this.readyState == 4 && this.status == 200) {
                // document.getElementById("dynamic_loc_amt").innerHTML = this.responseText;
                // document.getElementById("dynamic_loc_amt").innerHTML = this.responseText;
                setservicecityprice("dynamic_loc_amt",this.responseText);
                setservicecityprice("service_selected_city",city);
                setservicecityprice("service-selected-price",this.responseText);
                // document.getElementById("service_selected_city").innerHTML = city;
                // setservicecityprice('service_selected_city',this.responseText);
                var objSelect = document.getElementById("loc_select");
                var objSelect2 = document.getElementById("with-form-select1");
                // alert(this.responseText);
                if(this.responseText == '0'){
                    pricetag('none','block');
                }else{
                    pricetag('block','none');
                }
                //Set selected
                setSelectedValue(objSelect, city);
                setSelectedValue(objSelect2,city)
                setservicecityprice('service-selected-city',city);
                // alert(this.responseText);
            }
            };
            // xmlhttp.setRequestHeader("Content-Type", "application/x-www-form-urlencoded")
            xmlhttp.open("GET",baseurl+"Home/get_price?"+dat,true);
            xmlhttp.send();

    }

    function popupjquery(city) {
         var baseurl = "http://www.wehouse.in/";
        //  alert(baseurl);
        var dat = 'city='+city;
        var xmlhttp = new XMLHttpRequest();
            xmlhttp.onreadystatechange = function() {
            if (this.readyState == 4 && this.status == 200) {
                // document.getElementById("dynamic_loc_amt").innerHTML = this.responseText;
                // document.getElementById("dynamic_loc_amt").innerHTML = this.responseText;
                setservicecityprice("dynamic_loc_amt",this.responseText);
                setservicecityprice("service_selected_city",city);
                setservicecityprice("service-selected-price",this.responseText);
                // document.getElementById("service_selected_city").innerHTML = city;
                // setservicecityprice('service_selected_city',this.responseText);
                var objSelect = document.getElementById("loc_select");
                var objSelect2 = document.getElementById("with-form-select1");
                if(this.responseText == '0'){
                    pricetag('none','block');
                }else{
                    pricetag('block','none');
                }
                //Set selected
                setSelectedValue(objSelect, city);
                setSelectedValue(objSelect2,city)
                setservicecityprice('service-selected-city',city);
                // $('.menu-location').removeClass('selected');
                $('#popupcity_add').html(city);
                $('#myModal8').modal('toggle');
                // alert('city_'+city);
                // $('.citypopup').fadeOut();
                // alert(this.responseText);
            }
            };
            // xmlhttp.setRequestHeader("Content-Type", "application/x-www-form-urlencoded")
            xmlhttp.open("GET",baseurl+"Home/get_price?"+dat,true);
            xmlhttp.send();

    }

    function pricetag(beforepopup,afterpopup){
        $('.before_popup').css('display',beforepopup);
        $('.after_popup').css('display',afterpopup);
    }

    function setSelectedValue(selectObj, valueToSet) {
        for (var i = 0; i < selectObj.options.length; i++) {
            if (selectObj.options[i].text== valueToSet) {
                selectObj.options[i].selected = true;
                return;
            }
        }
    }

    function setservicecityprice(id,value){
        var obj = document.getElementById(id);
        if(obj !== null){
            obj.innerHTML = value;
        }
        // alert(value);
    }

    DropDown.prototype = {
        initEvents: function () {
            var obj = this;
            obj.dd.on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                $(this).toggleClass('active');
            });
            obj.opts.on('click', function () {
                var opt = $(this);
                obj.val = opt.text();
                obj.index = opt.index();
                obj.placeholder.text(obj.val);
                opt.siblings().removeClass('selected');
                opt.filter(':contains("' + obj.val + '")').addClass('selected');
            }).change();
        },
        getValue: function () {
            return this.val;
        },
        getIndex: function () {
            return this.index;
        }
    };

    $(function () {
        // create new variable for each menu
        var dd1 = new DropDown($('#noble-gases'));
        // var dd2 = new DropDown($('#other-gases'));
        $(document).click(function () {
            // close menu on document click
            $('.wrap-drop').removeClass('active');
        });
    });
</script>
                            
