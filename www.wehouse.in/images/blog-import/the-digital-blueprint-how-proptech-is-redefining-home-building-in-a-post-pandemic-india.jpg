<script src="http://www.wehouse.in/assets/front_end/js/request-quote-otp.js"></script>
	<script>
(function () {
	function bindQuoteFormOtp() {
		if (window._wehouseQuoteFormOtpBound) {
			return;
		}
		var $ = window.jQuery;
		if (!$ || !window.WehouseRequestQuoteOtp) {
			return;
		}
		window._wehouseQuoteFormOtpBound = true;
		if (!window.quoteOtpQuoteModal) {
			window.quoteOtpQuoteModal = WehouseRequestQuoteOtp.init({
				phoneSel: '#phonee',
				sendBtn: '#rq-quote-send-otp',
				verifyBtn: '#rq-quote-verify-otp',
				otpInput: '#rq-quote-otp',
				otpFields: '#rq-quote-otp-fields',
				statusEl: '#rq-quote-otp-status',
				errEl: '#rq-quote-otp-err',
				hintEl: '#rq-quote-otp-hint'
			});
		}
		$(document).off('submit.wehouseQuoteOtp', '#myformquote').on('submit.wehouseQuoteOtp', '#myformquote', function (e) {
			var valuee = $('[name=residence]:checked').val();
			var contacte = $('#phonee').val();
			var lene = String(contacte || '').length;
			if (valuee === 'International') {
				if (lene >= 11) {
					$('#rq-quote-phone-verified-token').val('');
					return;
				}
				e.preventDefault();
				return false;
			}
			if (lene === 10) {
				if (!window.quoteOtpQuoteModal || !quoteOtpQuoteModal.isVerifiedFor(String(contacte))) {
					e.preventDefault();
					$('#rq-quote-otp-err').text('Please verify your mobile with OTP (Send OTP → Verify).').show();
					return false;
				}
				$('#rq-quote-phone-verified-token').val(quoteOtpQuoteModal.getToken());
			}
		});
	}
	var tries = 0;
	var iv = setInterval(function () {
		tries++;
		if (window.jQuery && window.WehouseRequestQuoteOtp) {
			clearInterval(iv);
			jQuery(bindQuoteFormOtp);
		} else if (tries > 200) {
			clearInterval(iv);
		}
	}, 25);
})();
</script>
                                    
